VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Google OAuth Web client ID (Supabase → Auth → Providers → Google → Client ID).
# Baked fallback already in oauth.ts; only set this to override.
VITE_GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
# Razorpay Key ID (rzp_test_... for sandbox, rzp_live_... for production)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
